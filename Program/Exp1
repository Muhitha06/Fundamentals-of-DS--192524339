
import numpy as np
student_scores = np.array([ 
        [85, 90, 78, 88], 
        [92, 86, 95, 80], 
        [76, 89, 84, 91], 
        [88, 94, 90, 85] 
]) 
     
subjects = ["Math", "Science", "English", "History"] 
     
average_scores = np.mean(student_scores, axis=0) 
     
for i in range(len(subjects)):     print(subjects[i], "Average:", average_scores[i]) 
     
highest = np.argmax(average_scores) 
print("Highest Average Subject:", subjects[highest])

