
import numpy as np

# Sample data: Bedrooms, Square Footage, Sale Price
house_data = np.array([
    [3, 1200, 200000],
    [5, 1800, 350000],
    [4, 1500, 250000],
    [6, 2200, 450000],
    [5, 2000, 400000]
])

# Filter houses with more than 4 bedrooms
filtered = house_data[house_data[:, 0] > 4]

# Calculate average sale price
average = np.mean(filtered[:, 2])

print("Average Sale Price:", average)

